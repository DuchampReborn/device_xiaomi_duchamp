<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 switch track: 52x32dp pill, primary when checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/m3_switch_track_width"
                android:height="@dimen/m3_switch_track_height" />
            <corners android:radius="16dp" />
            <solid android:color="@color/m3_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/m3_switch_track_width"
                android:height="@dimen/m3_switch_track_height" />
            <corners android:radius="16dp" />
            <solid android:color="@color/m3_surface_container_highest" />
            <stroke
                android:width="2dp"
                android:color="@color/m3_outline" />
        </shape>
    </item>
</selector>
